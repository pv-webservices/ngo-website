---
import { copy, site, videos, img, type Lang } from '../data/site';
import Icon from './Icon.astro';
const { lang } = Astro.props as { lang: Lang };
const t = copy[lang];
---

<div class="video-grid">
  {videos.map((video) => (
    <a
      class="video-card hover-card"
      href={site.facebook}
      target="_blank"
      rel="noopener noreferrer"
    >
      <span class="video-thumb">
        <img
          src={img(video.image)}
          alt=""
          width="600"
          height="400"
          loading="lazy"
        />
        <span class="play-button" aria-hidden="true">
          <Icon name="play" size={22} filled />
        </span>
        <span class="video-source">
          <Icon name="facebook" size={13} />
          {t.watchOn}
        </span>
      </span>
      <span class="video-body">
        <strong>{video[lang][0]}</strong>
        <span>{video[lang][1]}</span>
      </span>
    </a>
  ))}
</div>
