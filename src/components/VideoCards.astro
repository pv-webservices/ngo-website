---
import { copy, videos, type Lang } from '../data/site';
import Icon from './Icon.astro';
const { lang, limit = videos.length } = Astro.props as {
  lang: Lang;
  limit?: number;
};
const t = copy[lang];
const items = videos.slice(0, limit);
---

<div class="video-grid">
  {items.map((video) => (
    <article class="video-card lift">
      <div class="video-frame">
        <video
          src={`/videos/${video.file}.mp4`}
          poster={`/images/posters/${video.file}.webp`}
          preload="none"
          playsinline
          width="478"
          height="850"
          aria-label={video[lang][0]}
        />
        <button class="video-play" type="button" data-video-play>
          <span class="play-icon" aria-hidden="true">
            <Icon name="play" size={22} filled />
          </span>
          <span class="sr-only">
            {t.playVideo}: {video[lang][0]}
          </span>
          <span class="video-duration" aria-hidden="true">
            {video.duration}
          </span>
        </button>
      </div>
      <h3>{video[lang][0]}</h3>
      <p>{video[lang][1]}</p>
    </article>
  ))}
</div>
