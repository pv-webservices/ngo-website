---
import { programs, copy, url, imgSm, type Lang } from '../data/site';
import Icon from './Icon.astro';
const {
  lang,
  limit = programs.length,
  exclude = '',
  featured = false,
} = Astro.props as {
  lang: Lang;
  limit?: number;
  exclude?: string;
  featured?: boolean;
};
const t = copy[lang];
const items = programs.filter((p) => p.slug !== exclude).slice(0, limit);
---

<div class:list={['program-grid', { 'is-featured': featured }]}>
  {items.map((p) => (
    <article class="program-card">
      <a
        href={url(lang, p.slug)}
        tabindex="-1"
        aria-hidden="true"
        class="program-image"
      >
        <img
          src={imgSm(p.image)}
          alt=""
          width="640"
          height="480"
          loading="lazy"
        />
      </a>
      <div class="program-body">
        <span class="program-number">0{programs.indexOf(p) + 1}</span>
        <h3>
          <a href={url(lang, p.slug)}>{p[lang].title}</a>
        </h3>
        <p>{p[lang].text}</p>
        <a class="text-link" href={url(lang, p.slug)}>
          {t.more}
          <span class="sr-only">: {p[lang].title}</span>
          <Icon name="arrow" size={15} />
        </a>
      </div>
    </article>
  ))}
</div>
