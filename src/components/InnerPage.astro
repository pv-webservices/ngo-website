---
import {
  copy,
  programs,
  photos,
  site,
  url,
  img,
  imgSm,
  srcset,
  photoCaption,
  type Lang,
} from '../data/site';
import {
  home,
  causes,
  plannedCause,
  statusLabels,
  mahila,
  transparency,
  type Status,
} from '../data/content';
import Icon from './Icon.astro';
import PageHero from './PageHero.astro';
import Gallery from './Gallery.astro';
import DonatePanel from './DonatePanel.astro';
import ProgramCards from './ProgramCards.astro';
import VideoCards from './VideoCards.astro';
const { lang, slug, title } = Astro.props as {
  lang: Lang;
  slug: string;
  title: string;
};
const t = copy[lang];
const program = programs.find((p) => p.slug === slug);
const policy =
  slug === 'privacy-policy'
    ? t.privacy
    : slug === 'terms'
      ? t.terms
      : slug === 'support-policy'
        ? t.supportPolicy
        : null;
const descriptions: Record<string, string> = {
  about: t.intro,
  'our-work': t.programsTitle,
  'our-journey': t.journeyText,
  activities: t.activityText,
  gallery: t.galleryText,
  videos: t.videosText,
  'get-involved': t.involvedText,
  donate: t.supportText,
  contact: t.contactText,
  'mahila-diwas': home[lang].mahilaText,
  transparency: home[lang].trustText,
};
const h = home[lang];
const tr = transparency[lang];
const status = statusLabels[lang];
const docRequest = `mailto:${site.email}?subject=${encodeURIComponent(
  lang === 'hi' ? 'दस्तावेज़ का अनुरोध' : 'Document request',
)}`;
// Extra photographs for the Events & Stories page, beyond the two on the homepage.
const storyExtras: Record<string, string[]> = {
  'eye-camp': [],
  winter: ['winter-fire', 'roadside-grooming', 'roadside-first-aid'],
  children: ['children-class'],
};
const festivals = [
  'holi-milan',
  'holi-elders-office',
  'office-cake',
  'distribution-office',
];
const description = program
  ? program[lang].text
  : policy
    ? t.policyIntro
    : descriptions[slug] || t.intro;
const involveTargets = [
  url(lang, 'contact'),
  url(lang, 'donate'),
  url(lang, 'contact'),
  site.facebook,
];
---

<PageHero
  lang={lang}
  slug={slug}
  title={title}
  description={description}
  program={program}
  policy={Boolean(policy)}
/>

{slug === 'about' && (
  <>
    <section class="section">
      <div class="container story-grid">
        <figure class="leader-photo">
          <img
            src={img('president-portrait')}
            width="400"
            height="455"
            alt=""
            loading="lazy"
          />
          <figcaption>
            <strong>{t.leader}</strong>
            {t.leaderRole}
          </figcaption>
        </figure>
        <div>
          <p class="eyebrow">{t.aboutEyebrow}</p>
          <h2>{t.aboutTitle}</h2>
          <p>{t.aboutText}</p>
          <p>{t.aboutText2}</p>
          <p class="values-line">{t.values}</p>
          <a href={url(lang, 'our-work')} class="btn btn-primary">
            {t.work}
            <Icon name="arrow" size={18} />
          </a>
        </div>
      </div>
    </section>
    <section class="section section-soft">
      <div class="container value-grid">
        <article id="mission" class="value-card lift">
          <span class="icon-badge">
            <Icon name="heart" size={26} />
          </span>
          <h2>{t.mission}</h2>
          <p>{t.missionText}</p>
        </article>
        <article id="vision" class="value-card lift">
          <span class="icon-badge">
            <Icon name="eye" size={26} />
          </span>
          <h2>{t.vision}</h2>
          <p>{t.visionText}</p>
        </article>
        <article id="objectives" class="value-card wide lift">
          <span class="icon-badge">
            <Icon name="target" size={26} />
          </span>
          <h2>{t.objectives}</h2>
          <p>{t.objectivesText}</p>
          <ul class="check-list">
            {t.objectivesList.map((objective) => (
              <li>
                <Icon name="check" size={18} />
                {objective}
              </li>
            ))}
          </ul>
        </article>
      </div>
    </section>
    <section class="section">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">{t.programsEyebrow}</p>
            <h2>{t.programsTitle}</h2>
          </div>
          <a class="text-link" href={url(lang, 'our-journey')}>
            {t.journeyLink}
            <Icon name="arrow" size={16} />
          </a>
        </div>
        <ProgramCards lang={lang} />
      </div>
    </section>
  </>
)}

{slug === 'our-work' && (
  <section class="section">
    <div class="container program-stories">
      {programs.map((p, i) => (
        <article
          id={p.slug}
          class:list={['story-grid', { reversed: i % 2 === 1 }]}
        >
          <figure class="story-image">
            <img
              src={img(p.image)}
              srcset={srcset(p.image)}
              sizes="(min-width: 900px) 45vw, 100vw"
              alt={p[lang].title}
              width="1200"
              height="900"
              loading="lazy"
            />
            <span class="story-number">0{i + 1}</span>
          </figure>
          <div>
            <span class:list={['status-chip', `is-${p.status}`]}>
              {status[p.status as Status]}
            </span>
            <h2 class="program-title">{p[lang].title}</h2>
            <p class="lead">{p[lang].short}</p>
            <p>{p[lang].why}</p>
            <ul class="check-list compact">
              {p[lang].focus.map((f) => (
                <li>
                  <Icon name="check" size={17} />
                  {f}
                </li>
              ))}
            </ul>
            <a class="text-link" href={url(lang, p.slug)}>
              {t.more}
              <span class="sr-only">: {p[lang].title}</span>
              <Icon name="arrow" size={16} />
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
)}

{slug === 'our-work' && (
  <section class="section section-soft">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{h.causesEyebrow}</p>
          <h2>
            {lang === 'hi'
              ? 'हमारे कार्य के अन्य हिस्से'
              : 'Also part of our work'}
          </h2>
          <p class="section-sub">{h.causesText}</p>
        </div>
      </div>
      <div class="cause-grid">
        {causes
          .filter((c) => !programs.some((p) => p.slug === c.href))
          .map((cause) => (
            <article class="cause-card lift">
              <a
                class="cause-image"
                href={url(lang, cause.href)}
                tabindex="-1"
                aria-hidden="true"
              >
                <img
                  src={imgSm(cause.image)}
                  width="640"
                  height="480"
                  alt=""
                  loading="lazy"
                />
              </a>
              <div class="cause-body">
                <span class:list={['status-chip', `is-${cause.status}`]}>
                  {status[cause.status]}
                </span>
                <h3>
                  <a href={url(lang, cause.href)}>{cause[lang][0]}</a>
                </h3>
                <p>{cause[lang][1]}</p>
              </div>
            </article>
          ))}
        <article class="cause-card planned-mini">
          <a
            class="cause-image"
            href={url(lang, plannedCause.href)}
            tabindex="-1"
            aria-hidden="true"
          >
            <img
              src={imgSm(plannedCause.image)}
              width="640"
              height="480"
              alt=""
              loading="lazy"
            />
          </a>
          <div class="cause-body">
            <span class="status-chip is-planned">{status.planned}</span>
            <h3>
              <a href={url(lang, plannedCause.href)}>{plannedCause[lang][0]}</a>
            </h3>
            <p>{plannedCause[lang][1]}</p>
          </div>
        </article>
      </div>
    </div>
  </section>
)}

{program && (
  <>
    <section class="section">
      <div class="container story-grid">
        <figure class="story-image">
          <img
            src={img(program.photo)}
            srcset={srcset(program.photo)}
            sizes="(min-width: 900px) 45vw, 100vw"
            alt={
              photos.find((photo) => photo.image === program.photo)?.[lang] ||
              program[lang].title
            }
            width="1200"
            height="900"
            loading="lazy"
          />
        </figure>
        <div>
          <p class="eyebrow">{program[lang].short}</p>
          <h2>{t.why}</h2>
          <p>{program[lang].why}</p>
          <h3>{t.provides}</h3>
          <ul class="focus-grid">
            {program[lang].focus.map((f) => (
              <li class="lift">
                <Icon name="check" size={18} />
                {f}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
    <section class="section section-soft">
      <div class="container">
        <div class="section-head">
          <div>
            <h2>{t.galleryTitle}</h2>
            <p class="section-sub">{t.galleryText}</p>
          </div>
          <a class="text-link" href={url(lang, 'gallery')}>
            {t.viewPhotos}
            <Icon name="arrow" size={16} />
          </a>
        </div>
        <Gallery lang={lang} carousel category={program.category} />
      </div>
    </section>
    <section class="section">
      <div class="container cta-card">
        <h2>{t.helpTitle}</h2>
        <p>{t.helpText}</p>
        <div class="btn-row center">
          <a class="btn btn-primary" href={url(lang, 'donate')}>
            {t.donate}
            <Icon name="arrow" size={18} />
          </a>
          <a class="btn btn-secondary" href={url(lang, 'get-involved')}>
            {t.involved}
            <Icon name="arrow" size={18} />
          </a>
        </div>
      </div>
    </section>
    <section class="section section-soft">
      <div class="container">
        <div class="section-head">
          <div>
            <h2>{t.related}</h2>
          </div>
        </div>
        <ProgramCards lang={lang} exclude={slug} />
      </div>
    </section>
  </>
)}

{slug === 'our-journey' && (
  <>
    <section
      class="h-journey photo-wash sketch"
      style="--bg:url('/images/photos/kendra-building-sm.webp')"
      id="beginnings"
      aria-labelledby="beginnings-title"
    >
      <div class="container h-journey-grid">
        <div class="h-journey-copy">
          <p class="eyebrow">{h.journeyEyebrow}</p>
          <h2 id="beginnings-title">{h.journeyTitle}</h2>
          {h.journeyText.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
          <p>
            {lang === 'hi'
              ? 'उस भवन पर लगे बैनर में संस्थान का “नशामुक्ति परामर्श एवं पुनर्वास केंद्र” लिखा है। नशे से जूझ रहे लोगों के लिए परामर्श हम भविष्य में फिर शुरू करना चाहते हैं; यह सेवा अभी नहीं चल रही है।'
              : 'The banner on that building names the Sansthan’s “Nasha Mukti Paramarsh evam Punarvas Kendra” (de-addiction counselling and rehabilitation centre). Counselling for people facing addiction is something we hope to offer again in future; it is not running today.'}
          </p>
          <div class="journey-photos">
            {['kendra-building', 'ashram-dormitory'].map((name) => (
              <figure>
                <img
                  src={imgSm(name)}
                  width="640"
                  height="480"
                  alt={photoCaption(name, lang)}
                  loading="lazy"
                />
                <figcaption>{photoCaption(name, lang)}</figcaption>
              </figure>
            ))}
          </div>
        </div>
        <article class="video-card h-journey-video">
          <div class="video-frame">
            <video
              src="/videos/ashram-beginnings.mp4"
              poster="/images/posters/ashram-beginnings.webp"
              preload="none"
              playsinline
              width="478"
              height="850"
              aria-label={h.journeyTitle}
            ></video>
            <button class="video-play" type="button" data-video-play>
              <span class="play-icon" aria-hidden="true">
                <Icon name="play" size={26} filled />
              </span>
              <span class="sr-only">{h.journeyVideo}</span>
              <span class="video-duration" aria-hidden="true">
                0:55
              </span>
            </button>
          </div>
          <p class="h-journey-note">{h.journeyVideoNote}</p>
        </article>
      </div>
    </section>
    <section class="section">
      <div class="container story-grid">
        <div>
          <p class="eyebrow">{t.journeyEyebrow}</p>
          <h2>{t.journeyTitle}</h2>
          <p>{t.aboutText}</p>
          <p>{t.aboutText2}</p>
          <a class="btn btn-primary" href={url(lang, 'activities')}>
            {t.titles[9]}
            <Icon name="arrow" size={18} />
          </a>
        </div>
        <ol class="journey-steps">
          {t.journey.map((step, i) => (
            <li class="lift">
              <span>0{i + 1}</span>
              <div>
                <h3>{step}</h3>
                <p>{t.journeyDescriptions[i]}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
    <section class="section section-soft">
      <div class="container">
        <div class="section-head">
          <div>
            <h2>{t.galleryTitle}</h2>
            <p class="section-sub">{t.galleryText}</p>
          </div>
        </div>
        <Gallery lang={lang} carousel />
      </div>
    </section>
    <section class="section">
      <div class="container cta-card">
        <h2>{t.vision}</h2>
        <p>{t.visionText}</p>
        <a href={url(lang, 'get-involved')} class="btn btn-primary">
          {t.involved}
          <Icon name="arrow" size={18} />
        </a>
      </div>
    </section>
  </>
)}

{slug === 'activities' && (
  <>
    <section class="section">
      <div class="container story-list">
        {h.stories.map((story, i) => (
          <article
            id={story.id}
            class:list={[
              'story-module',
              'story-anchor',
              `tone-${['saffron', 'green', 'purple'][i % 3]}`,
              { reversed: i % 2 === 1 },
            ]}
          >
            <div class="story-pair">
              <img
                class="story-pair-a"
                src={imgSm(story.images[0])}
                width="640"
                height="800"
                alt={story.alts[0]}
                loading="lazy"
              />
              <img
                class="story-pair-b"
                src={imgSm(story.images[1])}
                width="640"
                height="800"
                alt={story.alts[1]}
                loading="lazy"
              />
            </div>
            <div class="story-copy">
              <p class="story-kicker">{story.kicker}</p>
              <h2>{story.title}</h2>
              <p>{story.text}</p>
              {storyExtras[story.id].length > 0 && (
                <ul class="story-thumbs">
                  {storyExtras[story.id].map((name) => (
                    <li>
                      <img
                        src={imgSm(name)}
                        width="640"
                        height="640"
                        alt={photoCaption(name, lang)}
                        loading="lazy"
                      />
                    </li>
                  ))}
                </ul>
              )}
              <a class="text-link" href={url(lang, story.href)}>
                {story.link}
                <Icon name="arrow" size={15} />
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>
    <section class="section section-soft">
      <div class="container">
        <div class="section-head">
          <div>
            <p class="eyebrow">{h.mahilaEyebrow}</p>
            <h2>{h.mahilaTitle}</h2>
            <p class="section-sub">{h.mahilaText}</p>
          </div>
          <a class="btn btn-primary" href={url(lang, 'mahila-diwas')}>
            {h.mahilaLink}
            <Icon name="arrow" size={17} />
          </a>
        </div>
        <div class="festival-strip">
          {[
            'mahila-diwas-2022',
            'mahila-diwas-group',
            'mahila-diwas-honourees',
          ].map((name) => (
            <img
              src={imgSm(name)}
              width="640"
              height="480"
              alt={photoCaption(name, lang)}
              loading="lazy"
            />
          ))}
        </div>
      </div>
    </section>
    <section class="section">
      <div class="container">
        <div class="section-head">
          <div>
            <h2>
              {lang === 'hi'
                ? 'त्योहार और साथ बिताए पल'
                : 'Festivals and time together'}
            </h2>
            <p class="section-sub">{t.photoNote}</p>
          </div>
          <a class="text-link" href={url(lang, 'gallery')}>
            {t.viewPhotos}
            <Icon name="arrow" size={16} />
          </a>
        </div>
        <div class="activity-grid">
          {festivals.map((name) => (
            <article class="activity-card lift">
              <img
                src={imgSm(name)}
                width="640"
                height="480"
                alt=""
                loading="lazy"
              />
              <div>
                <h3>{photoCaption(name, lang)}</h3>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </>
)}

{slug === 'mahila-diwas' && (
  <>
    <section class="section">
      <div class="container">
        <div class="mahila-intro">
          <p class="lead">{mahila[lang].intro}</p>
          <nav
            class="album-nav"
            aria-label={lang === 'hi' ? 'एल्बम' : 'Albums'}
          >
            {mahila.albums.map((album) => (
              <a href={`#${album.id}`}>
                {album[lang][0]}
                <span>{album.photos.length}</span>
              </a>
            ))}
          </nav>
        </div>
        {mahila.albums.map((album, i) => (
          <section
            class="album"
            id={album.id}
            aria-labelledby={`${album.id}-title`}
          >
            <div class="album-head">
              <h2 id={`${album.id}-title`}>{album[lang][0]}</h2>
              <p>{album[lang][1]}</p>
            </div>
            <Gallery
              lang={lang}
              lightbox={i === mahila.albums.length - 1}
              items={album.photos.map((photo) => ({
                ...photo,
                category: 'women' as const,
              }))}
            />
          </section>
        ))}
        <p class="fine-print">{mahila[lang].note}</p>
      </div>
    </section>
    <section class="section section-soft">
      <div class="container cta-card">
        <h2>{h.involveTitle}</h2>
        <p>{h.involveText}</p>
        <div class="btn-row center">
          <a class="btn btn-primary" href={url(lang, 'get-involved')}>
            {h.volunteer}
            <Icon name="arrow" size={18} />
          </a>
          <a class="btn btn-secondary" href={url(lang, 'donate')}>
            {t.donate}
          </a>
        </div>
      </div>
    </section>
  </>
)}

{slug === 'transparency' && (
  <>
    <section class="section">
      <div class="container trust-layout">
        <div>
          <p class="eyebrow">{h.trustEyebrow}</p>
          <h2>{tr.publishedTitle}</h2>
          <dl class="fact-list">
            {tr.published.map(([label, value]) => (
              <div>
                <dt>{label}</dt>
                <dd>{value}</dd>
              </div>
            ))}
          </dl>
        </div>
        <aside class="doc-panel">
          <span class="icon-badge">
            <Icon name="file" size={26} />
          </span>
          <h2>{tr.requestTitle}</h2>
          <p>{tr.requestText}</p>
          <ul class="check-list">
            {tr.documents.map((doc) => (
              <li>
                <Icon name="check" size={17} />
                {doc}
              </li>
            ))}
          </ul>
          <a class="btn btn-primary" href={docRequest}>
            <Icon name="mail" size={18} />
            {tr.requestButton}
          </a>
        </aside>
      </div>
    </section>
    <section class="section section-soft">
      <div class="container value-grid">
        <article class="value-card lift">
          <span class="icon-badge">
            <Icon name="shield" size={26} />
          </span>
          <h2>{tr.taxTitle}</h2>
          <p>{tr.taxText}</p>
        </article>
        <article class="value-card lift">
          <span class="icon-badge">
            <Icon name="heart" size={26} />
          </span>
          <h2>{tr.useTitle}</h2>
          <p>{tr.useText}</p>
          <a class="text-link" href={url(lang, 'donate')}>
            {t.donate}
            <Icon name="arrow" size={16} />
          </a>
        </article>
      </div>
    </section>
  </>
)}

{slug === 'gallery' && (
  <section class="section">
    <div class="container">
      <Gallery lang={lang} full pageSize={18} />
    </div>
  </section>
)}

{slug === 'videos' && (
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>{t.videosEyebrow}</h2>
          <p class="section-sub">{t.videosPageText}</p>
        </div>
      </div>
      <VideoCards lang={lang} />
      <div class="social-cta">
        <a
          class="btn btn-facebook"
          href={site.facebook}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="facebook" size={18} />
          {t.followFacebook}
        </a>
        <a
          class="btn btn-instagram"
          href={site.instagram}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="instagram" size={18} />
          {t.followInstagram}
        </a>
      </div>
    </div>
  </section>
)}

{slug === 'get-involved' && (
  <>
    <section class="section">
      <div class="container involvement-grid">
        {t.involvedOptions.map((option, i) => (
          <article class="involve-card lift">
            <span class="icon-badge">
              <Icon name={['group', 'heart', 'shield', 'globe'][i]} size={28} />
            </span>
            <h2>{option}</h2>
            <p>{t.involvedDescriptions[i]}</p>
            <a
              class="card-link"
              href={involveTargets[i]}
              {...(i === 3
                ? { target: '_blank', rel: 'noopener noreferrer' }
                : {})}
            >
              {t.involvedActions[i]}
              <Icon name="arrow" size={15} />
            </a>
          </article>
        ))}
      </div>
    </section>
    <section class="section section-soft">
      <div class="container story-grid">
        <figure class="story-image">
          <img
            src={img('volunteers')}
            srcset={srcset('volunteers')}
            sizes="(min-width: 900px) 45vw, 100vw"
            width="960"
            height="1280"
            alt={photos.find((p) => p.image === 'volunteers')?.[lang] ?? ''}
            loading="lazy"
          />
        </figure>
        <div>
          <p class="eyebrow">{t.nav[5]}</p>
          <h2>{t.involvedTitle}</h2>
          <p>{t.involvedText}</p>
          <div class="btn-row">
            <a class="btn btn-primary" href={url(lang, 'contact')}>
              {t.contact}
              <Icon name="arrow" size={18} />
            </a>
            <a class="btn btn-secondary" href={`tel:${site.phones[0]}`}>
              <Icon name="phone" size={17} />
              {site.phoneLabels[0]}
            </a>
          </div>
        </div>
      </div>
    </section>
  </>
)}

{slug === 'donate' && (
  <>
    <section class="section donate-why">
      <div class="container donate-why-grid">
        <div>
          <p class="eyebrow">{h.whyEyebrow}</p>
          <h2>{h.whyTitle}</h2>
          <p class="lead">{h.whyLead}</p>
          <p>{h.whyText}</p>
        </div>
        <ul class="need-cards">
          {h.needs.map(([needTitle, text], i) => (
            <li>
              <span class="icon-badge">
                <Icon
                  name={['meal', 'stethoscope', 'sun', 'heart'][i]}
                  size={24}
                />
              </span>
              <strong>{needTitle}</strong>
              <span>{text}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
    <section class="section section-soft">
      <div class="container">
        <DonatePanel lang={lang} showButton={false} />
        <p class="donate-trust">
          <Icon name="shield" size={18} />
          {h.whyNote}{' '}
          <a class="text-link" href={url(lang, 'transparency')}>
            {h.trustLink}
            <Icon name="arrow" size={15} />
          </a>
        </p>
      </div>
    </section>
    <section class="section">
      <div class="container faq">
        <h2>{t.faqTitle}</h2>
        {t.faqs.map(([question, answer]) => (
          <details>
            <summary>{question}</summary>
            <p>{answer}</p>
          </details>
        ))}
        <a class="text-link" href={url(lang, 'support-policy')}>
          {t.titles[17]}
          <Icon name="arrow" size={16} />
        </a>
      </div>
    </section>
  </>
)}

{slug === 'contact' && (
  <section class="section">
    <div class="container contact-layout">
      <div>
        <p class="eyebrow">{t.contactEyebrow}</p>
        <h2>{t.contactTitle}</h2>
        <p>{t.contactText}</p>
        <div class="contact-methods">
          <div class="contact-card lift">
            <span class="mini-icon">
              <Icon name="phone" size={20} />
            </span>
            <div>
              <h3>{t.call}</h3>
              <a href={`tel:${site.phones[0]}`}>{site.phoneLabels[0]}</a>
              <a href={`tel:${site.phones[1]}`}>{site.phoneLabels[1]}</a>
            </div>
          </div>
          <div class="contact-card lift">
            <span class="mini-icon">
              <Icon name="mail" size={20} />
            </span>
            <div>
              <h3>{t.email}</h3>
              <a class="break" href={`mailto:${site.email}`}>
                {site.email}
              </a>
            </div>
          </div>
          <div class="contact-card lift">
            <span class="mini-icon">
              <Icon name="pin" size={20} />
            </span>
            <div>
              <h3>{t.office}</h3>
              <p>{site.address[lang]}</p>
              <a href={site.mapUrl} target="_blank" rel="noopener noreferrer">
                {t.directions}
              </a>
            </div>
          </div>
        </div>
      </div>
      <form
        id="contact-form"
        class="enquiry-form"
        data-email={site.email}
        data-ready={t.formSuccess}
      >
        <h2>{t.formTitle}</h2>
        <p>{t.formNote}</p>
        <div class="form-row">
          <label for="name">
            {t.fields[0]}
            <input
              id="name"
              name="name"
              autocomplete="name"
              required
              maxlength="100"
            />
          </label>
          <label for="phone">
            {t.fields[1]}
            <input
              id="phone"
              name="phone"
              type="tel"
              autocomplete="tel"
              pattern="[+0-9\s\(\)\-]{7,20}"
              maxlength="20"
            />
          </label>
        </div>
        <label for="email">
          {t.fields[2]}
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            required
            maxlength="150"
          />
        </label>
        <label for="subject">
          {t.fields[3]}
          <select id="subject" name="subject">
            {t.subjects.map((s) => (
              <option>{s}</option>
            ))}
          </select>
        </label>
        <label for="message">
          {t.fields[4]}
          <textarea
            id="message"
            name="message"
            required
            minlength="10"
            maxlength="2500"
            rows="5"
          ></textarea>
        </label>
        <button class="btn btn-primary" type="submit">
          {t.formSubmit}
          <Icon name="mail" size={18} />
        </button>
        <p class="form-status" role="status"></p>
        <a class="btn btn-outline draft-link" hidden>
          {t.formFallback}
          <Icon name="arrow" size={18} />
        </a>
      </form>
    </div>
  </section>
)}

{policy && (
  <section class="section">
    <div class="container policy-content">
      {policy.map(([heading, text]) => (
        <article>
          <h2>{heading}</h2>
          <p>{text}</p>
        </article>
      ))}
      <a class="text-link" href={`mailto:${site.email}`}>
        {t.email}
        <Icon name="arrow" size={16} />
      </a>
    </div>
  </section>
)}
