---
import { copy, url, imgSm, type Lang } from '../data/site';
import Icon from './Icon.astro';
import BankDetails from './BankDetails.astro';
import { chrome } from '../data/content';
const { lang, showButton = true } = Astro.props as {
  lang: Lang;
  showButton?: boolean;
};
const t = copy[lang];
---

<div class="donate-panel">
  <div class="donate-copy">
    <p class="eyebrow">{t.supportEyebrow}</p>
    <h2>{t.supportTitle}</h2>
    <p>{t.supportText}</p>
    <ul class="check-list">
      {t.supportUses.map((use) => (
        <li>
          <Icon name="check" size={17} />
          {use}
        </li>
      ))}
    </ul>
    {showButton && (
      <a class="btn btn-primary" href={url(lang, 'donate')}>
        {t.donate}
        <Icon name="arrow" size={18} />
      </a>
    )}
    <figure class="donate-photo">
      <img
        src={imgSm('resident-banner')}
        width="640"
        height="1138"
        alt=""
        loading="lazy"
      />
    </figure>
  </div>
  <div class="donate-methods" id="donate-methods">
    <BankDetails lang={lang} />
    <p class="india-only">
      <Icon name="globe" size={18} />
      {chrome[lang].indiaOnly}
    </p>
    <div class="qr-panel lift">
      <img
        src="/images/donation-qr.png"
        alt={t.qrAlt}
        width="295"
        height="295"
        loading="lazy"
      />
      <div>
        <h3>{t.scan}</h3>
        <p>{t.qrNote}</p>
      </div>
    </div>
  </div>
</div>
