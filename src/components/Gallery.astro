---
import { copy, photos, img, imgSm, type Lang, type Photo } from '../data/site';
import Icon from './Icon.astro';
const {
  lang,
  full = false,
  carousel = false,
  category = '',
  limit = photos.length,
  items: customItems,
  lightbox = true,
  pageSize = 0,
} = Astro.props as {
  lang: Lang;
  full?: boolean;
  carousel?: boolean;
  category?: string;
  limit?: number;
  items?: Photo[];
  lightbox?: boolean;
  pageSize?: number;
};
const t = copy[lang];
const filters = Object.entries(t.galleryFilters);
// A program page leads with photographs from its own category.
const ordered = customItems
  ? customItems
  : category
    ? [
        ...photos.filter((p) => p.category === category),
        ...photos.filter((p) => p.category !== category),
      ]
    : photos;
const items = ordered.slice(0, limit);
const hasMore = pageSize > 0 && items.length > pageSize;
const moreLabel =
  lang === 'hi' ? 'और तस्वीरें दिखाएँ' : 'Show more photographs';
---

{full && (
  <div class="gallery-filters" role="group" aria-label={t.titles[10]}>
    <button class="active" data-filter="all" aria-pressed="true">
      {t.all}
    </button>
    {filters.map(([key, label]) => (
      <button data-filter={key} aria-pressed="false">
        {label}
      </button>
    ))}
  </div>
)}
<div
  class:list={['gallery-wrap', { 'is-carousel': carousel }]}
  data-gallery-wrap
>
  {carousel && (
    <button
      class="carousel-btn prev"
      data-carousel="-1"
      aria-label={t.previous}
    >
      <Icon name="chevron-left" size={22} />
    </button>
  )}
  <div
    class:list={[
      'gallery-grid',
      { 'full-gallery': full || customItems, 'carousel-track': carousel },
    ]}
  >
    {items.map((photo, i) => (
      <figure
        data-category={photo.category}
        data-more={hasMore && i >= pageSize ? '' : undefined}
        hidden={hasMore && i >= pageSize}
        class="gallery-item lift"
      >
        <button
          class="gallery-photo"
          data-gallery={i}
          data-src={img(photo.image)}
          data-caption={photo[lang]}
          aria-label={`${t.enlarge}: ${photo[lang]}`}
        >
          <img
            src={imgSm(photo.image)}
            alt=""
            width="640"
            height="480"
            loading="lazy"
            decoding="async"
          />
        </button>
        <figcaption>{photo[lang]}</figcaption>
      </figure>
    ))}
  </div>
  {carousel && (
    <button class="carousel-btn next" data-carousel="1" aria-label={t.next}>
      <Icon name="chevron-right" size={22} />
    </button>
  )}
  {hasMore && (
    <div class="gallery-more">
      <button class="btn btn-secondary" type="button" data-gallery-more>
        {moreLabel}
        <span class="gallery-more-count">({items.length - pageSize})</span>
      </button>
    </div>
  )}
</div>
{full && <p class="fine-print">{t.photoNote}</p>}
{lightbox && (
  <dialog class="lightbox" aria-label={t.titles[10]}>
    <button class="lightbox-close" data-close aria-label={t.close}>
      <Icon name="close" />
    </button>
    <div class="lightbox-content">
      <img alt="" />
      <p></p>
    </div>
    <div class="lightbox-controls">
      <button data-prev aria-label={t.previous}>
        <Icon name="chevron-left" size={20} />
      </button>
      <span data-counter></span>
      <button data-next aria-label={t.next}>
        <Icon name="chevron-right" size={20} />
      </button>
    </div>
  </dialog>
)}
