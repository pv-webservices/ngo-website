---
import { copy, lives, imgSm, type Lang } from '../data/site';
import Icon from './Icon.astro';
const { lang } = Astro.props as { lang: Lang };
const t = copy[lang];
---

<div class="lives-strip" data-lives>
  {lives.map((row, r) => (
    <div class:list={['lives-row', { reverse: r % 2 === 1 }]}>
      <ul class="lives-track">
        {[0, 1].map((copyIndex) =>
          row.map((person) => (
            <li aria-hidden={copyIndex === 1 ? 'true' : undefined}>
              <figure class="lift">
                <img
                  src={imgSm(person.image)}
                  width="240"
                  height="320"
                  alt={copyIndex === 1 ? '' : person[lang]}
                  loading="lazy"
                  decoding="async"
                />
                <figcaption>{person[lang]}</figcaption>
              </figure>
            </li>
          )),
        )}
      </ul>
    </div>
  ))}
  <button class="lives-toggle" type="button" aria-pressed="false">
    <span class="icon-pause" aria-hidden="true"></span>
    <Icon name="play" size={14} filled />
    <span class="sr-only">{t.pauseStrip}</span>
  </button>
</div>
