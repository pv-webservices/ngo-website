---
import {
  copy,
  site,
  url,
  img,
  imgSm,
  srcset,
  photoCaption,
  type Lang,
} from '../data/site';
import {
  home,
  chrome,
  heroSlides,
  proofImages,
  splitLast,
  causes,
  plannedCause,
  statusLabels,
  mahila,
} from '../data/content';
import Icon from './Icon.astro';
import DonatePanel from './DonatePanel.astro';
const { lang } = Astro.props as { lang: Lang };
const t = copy[lang];
const h = home[lang];
const c = chrome[lang];
const status = statusLabels[lang];
// Representative Mahila Diwas photographs; the full collection lives on /mahila-diwas/.
const mahilaPicks = [
  'mahila-diwas-2022',
  'mahila-diwas-felicitation',
  'mahila-diwas-honourees',
  'kendra-women-members',
];
const needIcons = ['meal', 'stethoscope', 'sun', 'heart'];
const proofIcons = ['elder', 'eye', 'group', 'child'];
const proofTones = ['saffron', 'sky', 'purple', 'green'];
const causeTones = ['saffron', 'green', 'red', 'blue', 'purple', 'sky'];
// Who we are: a grid of photographs that never overlap one another.
const whoGrid = [
  { image: 'elders-arched-window', cls: 'wb-a' },
  { image: 'window-conversation', cls: 'wb-b' },
  { image: 'street-outreach', cls: 'wb-c' },
  { image: 'volunteers-logo-wall', cls: 'wb-d' },
];
const whyPhotos = ['resident-portrait-woman', 'office-elders', 'wheelchair-care'];
const [proofLead, proofLast] = splitLast(h.proofTitle);
const [whoLead, whoLast] = splitLast(h.whoTitle);
const [causesLead, causesLast] = splitLast(h.causesTitle);
const [storiesLead, storiesLast] = splitLast(h.storiesTitle);
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero-deco" aria-hidden="true">
    <span class="blob blob-sun"></span>
    <span class="blob blob-sky"></span>
    <span class="blob blob-rose"></span>
  </div>
  <div
    class="hero-stage"
    role="group"
    aria-roledescription={lang === 'hi' ? 'स्लाइड शो' : 'carousel'}
    aria-label={c.slidesLabel}
  >
    <div class="hero-slides">
      {heroSlides.map((slide, i) => (
        <figure
          class:list={['hero-slide', { 'is-active': i === 0, 'fade-top-right': slide.fadeTopRight }]}
          data-slide
          data-caption={photoCaption(slide.image, lang)}
          aria-hidden={i === 0 ? undefined : 'true'}
        >
          <img
            src={img(slide.image)}
            srcset={srcset(slide.image)}
            sizes="(min-width: 1000px) 58vw, 100vw"
            width="1200"
            height="1000"
            style={`object-position:${slide.focus}`}
            alt={photoCaption(slide.image, lang)}
            loading={i < 2 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
            decoding="async"
          />
        </figure>
      ))}
    </div>
    <p class="hero-caption" aria-hidden="true" data-hero-caption>
      {photoCaption(heroSlides[0].image, lang)}
    </p>
    <div class="hero-controls">
      <div class="hero-dots">
        {heroSlides.map((_, i) => (
          <button
            type="button"
            class="hero-dot"
            data-goto={i}
            aria-label={`${c.goToSlide} ${i + 1} / ${heroSlides.length}`}
            aria-current={i === 0 ? 'true' : undefined}
          >
            <span></span>
          </button>
        ))}
      </div>
      <button
        class="hero-toggle"
        type="button"
        aria-pressed="false"
        data-label-pause={c.pauseSlides}
        data-label-play={c.playSlides}
      >
        <span class="icon-pause-bars" aria-hidden="true"></span>
        <Icon name="play" size={13} filled />
        <span class="sr-only">{c.pauseSlides}</span>
      </button>
    </div>
  </div>
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="hero-kicker">
        <span class="chip chip-sun">
          <Icon name="pin" size={14} />
          {h.heroEyebrow}
        </span>
        <span class="chip chip-green">{h.regd}</span>
      </p>
      <h1 id="hero-title">
        {h.heroTitle[0]}
        <span class="hero-accent">{h.heroTitle[1]}</span>
      </h1>
      <p class="hero-text">{h.heroText}</p>
      <div class="btn-row">
        <a class="btn btn-primary" href={url(lang, 'donate')}>
          <Icon name="heart" size={17} filled />
          {t.donate}
        </a>
        <a class="btn btn-secondary" href={url(lang, 'our-work')}>
          {t.work}
          <Icon name="arrow" size={17} />
        </a>
      </div>
      <a class="h-watch" href="#journey">
        <span class="h-watch-icon" aria-hidden="true">
          <Icon name="play" size={13} filled />
        </span>
        {h.heroWatch}
      </a>
    </div>
  </div>
</section>

<section class="h-proof sketch" aria-labelledby="proof-title">
  <div class="container">
    <div class="h-proof-head">
      <p class="eyebrow">{h.proofEyebrow}</p>
      <h2 id="proof-title">
        {proofLead}<span class="hl">{proofLast}</span>
      </h2>
    </div>
    <ol class="proof-grid">
      {h.proof.map((item, i) => (
        <li class:list={['proof-card', 'lift', `tone-${proofTones[i]}`]}>
          <a
            class="proof-media"
            href={url(lang, item.href)}
            tabindex="-1"
            aria-hidden="true"
          >
            <img
              src={imgSm(proofImages[i].image)}
              width="640"
              height="560"
              style={`object-position:${proofImages[i].focus}`}
              alt=""
              loading="lazy"
              decoding="async"
            />
          </a>
          <div class="proof-body">
            <span class="proof-icon" aria-hidden="true">
              <Icon name={proofIcons[i]} size={22} />
            </span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <a class="text-link" href={url(lang, item.href)}>
              {item.link}
              <Icon name="arrow" size={15} />
            </a>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="section h-who" aria-labelledby="who-title">
  <div class="container h-who-grid">
    <div class="who-bento">
      {whoGrid.map((cell) => (
        <figure class:list={['wb', cell.cls]}>
          <img
            src={cell.cls === 'wb-a' ? img(cell.image) : imgSm(cell.image)}
            width="640"
            height="800"
            alt={photoCaption(cell.image, lang)}
            loading="lazy"
            decoding="async"
          />
        </figure>
      ))}
      <div class="wb wb-note">
        <Icon name="heart" size={26} filled />
        <p>{h.heroEyebrow}</p>
        <span>{h.regd}</span>
      </div>
    </div>
    <div class="h-who-copy">
      <p class="eyebrow">{h.whoEyebrow}</p>
      <h2 id="who-title">
        {whoLead}<span class="hl">{whoLast}</span>
      </h2>
      {h.whoText.map((paragraph, i) => (
        <p class={i === 0 ? 'lead' : undefined}>{paragraph}</p>
      ))}
      <div class="btn-row">
        <a class="btn btn-secondary" href={url(lang, 'about')}>
          {t.titles[1]}
          <Icon name="arrow" size={17} />
        </a>
        <a class="text-link" href={url(lang, 'our-journey')}>
          {t.titles[8]}
          <Icon name="arrow" size={15} />
        </a>
      </div>
    </div>
  </div>
</section>

<section
  class="h-why photo-wash sketch"
  style="--bg:url('/images/photos/ashram-dormitory-sm.webp')"
  aria-labelledby="why-title"
>
  <div class="container h-why-grid">
    <div class="h-why-copy">
      <p class="eyebrow">{h.whyEyebrow}</p>
      <h2 id="why-title">{h.whyTitle}</h2>
      <p class="h-why-lead">{h.whyLead}</p>
      <ul class="h-needs">
        {h.needs.map(([title, text], i) => (
          <li class:list={[`tone-${proofTones[i]}`]}>
            <span class="h-need-icon" aria-hidden="true">
              <Icon name={needIcons[i]} size={22} />
            </span>
            <span>
              <strong>{title}</strong>
              {text}
            </span>
          </li>
        ))}
      </ul>
      <p>{h.whyText}</p>
      <div class="btn-row">
        <a class="btn btn-primary" href={url(lang, 'donate')}>
          <Icon name="heart" size={17} filled />
          {t.donate}
        </a>
        <a class="btn btn-secondary" href={`tel:${site.phones[0]}`}>
          <Icon name="phone" size={17} />
          {site.phoneLabels[0]}
        </a>
      </div>
      <p class="h-why-note">{h.whyNote}</p>
    </div>
    <div class="h-why-media" aria-hidden="true">
      {whyPhotos.map((name, i) => (
        <figure class:list={['why-tile', `why-tile-${i + 1}`]}>
          <img
            src={imgSm(name)}
            width="640"
            height="900"
            alt=""
            loading="lazy"
            decoding="async"
          />
        </figure>
      ))}
    </div>
  </div>
</section>

<section class="section h-causes sketch" aria-labelledby="causes-title">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow">{h.causesEyebrow}</p>
        <h2 id="causes-title">
          {causesLead}<span class="hl">{causesLast}</span>
        </h2>
        <p class="section-sub">{h.causesText}</p>
      </div>
      <a class="text-link" href={url(lang, 'our-work')}>
        {t.viewPrograms}
        <Icon name="arrow" size={16} />
      </a>
    </div>
    <div class="cause-grid">
      {causes.map((cause, i) => (
        <article class:list={['cause-card', 'lift', `tone-${causeTones[i]}`]}>
          <a
            class="cause-image"
            href={url(lang, cause.href)}
            tabindex="-1"
            aria-hidden="true"
          >
            <img
              src={imgSm(cause.image)}
              width="640"
              height="480"
              alt=""
              loading="lazy"
              decoding="async"
            />
            <span class="cause-icon">
              <Icon name={cause.icon} size={22} />
            </span>
          </a>
          <div class="cause-body">
            <span class:list={['status-chip', `is-${cause.status}`]}>
              {status[cause.status]}
            </span>
            <h3>
              <a href={url(lang, cause.href)}>{cause[lang][0]}</a>
            </h3>
            <p>{cause[lang][1]}</p>
            <a class="text-link" href={url(lang, cause.href)}>
              {t.more}
              <span class="sr-only">: {cause[lang][0]}</span>
              <Icon name="arrow" size={15} />
            </a>
          </div>
        </article>
      ))}
    </div>
    <article class="planned-card">
      <img
        src={imgSm(plannedCause.image)}
        width="640"
        height="512"
        alt=""
        loading="lazy"
      />
      <div>
        <span class="status-chip is-planned">
          {h.plannedLabel} · {status.planned}
        </span>
        <h3>{plannedCause[lang][0]}</h3>
        <p>{plannedCause[lang][1]}</p>
        <a class="text-link" href={url(lang, plannedCause.href)}>
          {t.titles[8]}
          <Icon name="arrow" size={15} />
        </a>
      </div>
    </article>
  </div>
</section>

<section
  class="h-journey photo-wash sketch"
  style="--bg:url('/images/photos/kendra-building-sm.webp')"
  id="journey"
  aria-labelledby="journey-title"
>
  <div class="container h-journey-grid">
    <div class="h-journey-copy">
      <p class="eyebrow">{h.journeyEyebrow}</p>
      <h2 id="journey-title">{h.journeyTitle}</h2>
      {h.journeyText.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
      <figure class="h-journey-still">
        <img
          src={imgSm('ashram-dormitory')}
          width="640"
          height="360"
          alt={photoCaption('ashram-dormitory', lang)}
          loading="lazy"
        />
        <figcaption>{photoCaption('ashram-dormitory', lang)}</figcaption>
      </figure>
      <a class="btn btn-secondary" href={url(lang, 'our-journey')}>
        {h.journeyLink}
        <Icon name="arrow" size={17} />
      </a>
    </div>
    <article class="video-card h-journey-video">
      <div class="video-frame">
        <video
          src="/videos/ashram-beginnings.mp4"
          poster="/images/posters/ashram-beginnings.webp"
          preload="none"
          playsinline
          width="478"
          height="850"
          aria-label={h.journeyTitle}
        ></video>
        <button class="video-play" type="button" data-video-play>
          <span class="play-icon" aria-hidden="true">
            <Icon name="play" size={26} filled />
          </span>
          <span class="sr-only">{h.journeyVideo}</span>
          <span class="video-duration" aria-hidden="true">
            0:55
          </span>
        </button>
      </div>
      <p class="h-journey-note">{h.journeyVideoNote}</p>
    </article>
  </div>
</section>

<section class="section h-mahila sketch" aria-labelledby="mahila-title">
  <div class="container h-mahila-grid">
    <div class="h-mahila-copy">
      <p class="eyebrow">{h.mahilaEyebrow}</p>
      <h2 id="mahila-title">{h.mahilaTitle}</h2>
      <p class="lead">{h.mahilaText}</p>
      <p class="h-mahila-count">
        {mahila.albums.reduce((sum, album) => sum + album.photos.length, 0)}
        {lang === 'hi' ? ' तस्वीरें · ' : ' photographs · '}
        {mahila.albums.length}
        {lang === 'hi' ? ' एल्बम' : ' albums'}
      </p>
      <a class="btn btn-primary" href={url(lang, 'mahila-diwas')}>
        {h.mahilaLink}
        <Icon name="arrow" size={17} />
      </a>
    </div>
    <div class="h-mahila-mosaic">
      {mahilaPicks.map((name, i) => (
        <figure class:list={['h-mosaic', `h-mosaic-${i + 1}`]}>
          <img
            src={i === 0 ? img(name) : imgSm(name)}
            width="640"
            height="480"
            alt={photoCaption(name, lang)}
            loading="lazy"
          />
        </figure>
      ))}
    </div>
  </div>
</section>

<section class="section h-stories" aria-labelledby="stories-title">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow">{h.storiesEyebrow}</p>
        <h2 id="stories-title">
          {storiesLead}<span class="hl">{storiesLast}</span>
        </h2>
      </div>
      <a class="text-link" href={url(lang, 'activities')}>
        {t.titles[9]}
        <Icon name="arrow" size={16} />
      </a>
    </div>
    <div class="story-list">
      {h.stories.map((story, i) => (
        <article
          class:list={[
            'story-module',
            `tone-${causeTones[i * 2]}`,
            { reversed: i % 2 === 1 },
          ]}
        >
          <div class="story-pair">
            <img
              class="story-pair-a"
              src={imgSm(story.images[0])}
              width="640"
              height="800"
              alt={story.alts[0]}
              loading="lazy"
            />
            <img
              class="story-pair-b"
              src={imgSm(story.images[1])}
              width="640"
              height="800"
              alt={story.alts[1]}
              loading="lazy"
            />
          </div>
          <div class="story-copy">
            <p class="story-kicker">{story.kicker}</p>
            <h3>{story.title}</h3>
            <p>{story.text}</p>
            <a class="text-link" href={url(lang, story.href)}>
              {story.link}
              <Icon name="arrow" size={15} />
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section h-trust sketch" aria-labelledby="trust-title">
  <div class="container h-trust-grid">
    <div>
      <p class="eyebrow">{h.trustEyebrow}</p>
      <h2 id="trust-title">{h.trustTitle}</h2>
      <p class="lead">{h.trustText}</p>
      <a class="btn btn-secondary" href={url(lang, 'transparency')}>
        {h.trustLink}
        <Icon name="arrow" size={17} />
      </a>
    </div>
    <ul class="trust-list">
      {h.trustPoints.map((point, i) => (
        <li class:list={[`tone-${causeTones[i + 1]}`]}>
          <span class="trust-icon" aria-hidden="true">
            <Icon name={['file', 'bank', 'shield', 'check'][i]} size={20} />
          </span>
          {point}
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="section section-soft" id="donate">
  <div class="container">
    <DonatePanel lang={lang} />
  </div>
</section>

<section class="h-involve sketch" aria-labelledby="involve-title">
  <div class="container h-involve-inner">
    <div>
      <h2 id="involve-title">{h.involveTitle}</h2>
      <p>{h.involveText}</p>
    </div>
    <div class="btn-row">
      <a class="btn btn-primary" href={url(lang, 'get-involved')}>
        {h.volunteer}
        <Icon name="arrow" size={17} />
      </a>
      <a class="btn btn-secondary" href={url(lang, 'contact')}>
        {t.contact}
      </a>
    </div>
  </div>
</section>
