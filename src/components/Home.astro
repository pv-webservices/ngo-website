---
import { copy, stats, url, img, imgSm, srcset, type Lang } from '../data/site';
import Icon from './Icon.astro';
import ProgramCards from './ProgramCards.astro';
import DonatePanel from './DonatePanel.astro';
import VideoCards from './VideoCards.astro';
import LivesStrip from './LivesStrip.astro';
const { lang } = Astro.props as { lang: Lang };
const t = copy[lang];
---

<section class="hero">
  <div class="hero-bg" aria-hidden="true">
    <svg class="hero-wave" viewBox="0 0 800 900" preserveAspectRatio="none">
      <defs>
        <linearGradient id="hero-wave-fill" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#a42a24" />
          <stop offset="1" stop-color="#6e1517" />
        </linearGradient>
      </defs>
      <path
        d="M330 0C250 120 300 230 230 330 150 445 40 470 60 620 78 760 200 830 150 900H800V0Z"
        fill="url(#hero-wave-fill)"
      ></path>
      <path
        d="M420 0C380 150 470 260 420 380 370 500 250 560 300 720 330 810 420 860 400 900"
        class="hero-wave-line"
      ></path>
      <path
        d="M800 640C700 650 610 720 590 820 584 850 588 880 596 900"
        class="hero-wave-line"
      ></path>
    </svg>
    <span class="hero-orb hero-orb-1"></span>
    <span class="hero-orb hero-orb-2"></span>
    <svg class="hero-leaves" viewBox="0 0 120 360">
      <path class="hero-stem" d="M60 360C64 260 56 150 72 10"></path>
      <path d="M62 300c-30-6-48-26-52-50 28 2 48 22 52 50Z"></path>
      <path d="M63 250c26-10 44-32 46-58-26 6-44 28-46 58Z"></path>
      <path d="M62 200c-28-8-44-30-46-56 26 4 44 26 46 56Z"></path>
      <path d="M66 150c24-10 40-32 40-56-24 6-40 28-40 56Z"></path>
      <path d="M67 100c-24-8-38-28-38-50 22 4 38 24 38 50Z"></path>
      <path d="M71 52c18-10 28-26 28-44-18 6-28 22-28 44Z"></path>
    </svg>
  </div>
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{t.heroEyebrow}</p>
      <h1>
        {t.heroTitle[0]} <span class="hero-highlight">{t.heroTitle[1]}</span>{' '}
        {t.heroTitle[2]}
      </h1>
      <p class="hero-text">{t.heroText}</p>
      <div class="btn-row">
        <a class="btn btn-primary btn-lg" href={url(lang, 'donate')}>
          {t.donate}
          <Icon name="arrow" size={18} />
        </a>
        <a class="btn btn-outline-brand btn-lg" href="#impact">
          {t.seeImpact}
          <Icon name="arrow" size={18} />
        </a>
      </div>
      <ul class="hero-credentials">
        {t.heroCredentials.map(([title, text], i) => (
          <li>
            <span class="hero-credential-icon">
              <Icon name={['shield', 'file', 'group'][i]} size={22} />
            </span>
            <span>
              <strong>{title}</strong>
              {text}
            </span>
          </li>
        ))}
      </ul>
    </div>
    <div class="hero-media">
      <svg class="hero-spark" viewBox="0 0 60 60" aria-hidden="true">
        <path d="M8 40 26 52M24 10l10 22M50 4l-4 26"></path>
      </svg>
      <figure class="hero-photo hero-photo-main">
        <img
          src={img('residents-gathering')}
          srcset={srcset('residents-gathering')}
          sizes="(min-width: 1000px) 30vw, 60vw"
          width="1200"
          height="1600"
          alt={t.heroAlt}
          fetchpriority="high"
        />
        <figcaption class="hero-place">
          <Icon name="pin" size={18} />
          {t.heroPlace}
        </figcaption>
      </figure>
      <figure class="hero-photo hero-photo-top">
        <img
          src={imgSm('shared-meal')}
          width="640"
          height="1138"
          alt={t.heroPhotoAlts[0]}
        />
      </figure>
      <figure class="hero-photo hero-photo-bottom">
        <img
          src={imgSm('hand-care')}
          width="640"
          height="1023"
          alt={t.heroPhotoAlts[1]}
        />
      </figure>
      <p class="hero-note hero-note-meal">
        <span class="hero-note-icon">
          <Icon name="meal" size={20} />
        </span>
        {t.heroNotes[0]}
      </p>
      <p class="hero-note hero-note-care">
        <span class="hero-note-icon">
          <Icon name="stethoscope" size={20} />
        </span>
        {t.heroNotes[1]}
      </p>
      <div class="hero-promise">
        <span class="hero-promise-icon">
          <Icon name="heart" size={26} />
        </span>
        <p class="hero-promise-title">{t.heroPromise}</p>
        <p class="hero-promise-text">{t.heroPromiseText}</p>
      </div>
    </div>
  </div>
</section>

<section class="impact" id="impact" aria-labelledby="impact-title">
  <div class="container impact-grid">
    <h2 id="impact-title" class="impact-title">
      <span>{t.impactEyebrow}</span>
      {t.impactTitle}
    </h2>
    <dl class="stats">
      {stats.map((s, i) => (
        <div>
          <dt>{t.stats[i]}</dt>
          <dd data-count={s.value}>{s.value}+</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<section class="section" aria-labelledby="about-title">
  <div class="container about-grid">
    <figure class="leader-photo">
      <img
        src={img('president-portrait')}
        width="400"
        height="455"
        alt=""
        loading="lazy"
      />
      <figcaption>
        <strong>{t.leader}</strong>
        {t.leaderRole}
      </figcaption>
    </figure>
    <div class="about-copy">
      <p class="eyebrow">{t.aboutEyebrow}</p>
      <h2 id="about-title">{t.aboutTitle}</h2>
      <p class="lead">{t.aboutText}</p>
      <p>{t.aboutText2}</p>
      <a class="text-link" href={url(lang, 'about')}>
        {t.read}
        <Icon name="arrow" size={16} />
      </a>
    </div>
  </div>
</section>

<section class="section section-paper" aria-labelledby="programs-title">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow">{t.eyebrow}</p>
        <h2 id="programs-title">{t.programsTitle}</h2>
      </div>
      <a class="text-link" href={url(lang, 'our-work')}>
        {t.viewPrograms}
        <Icon name="arrow" size={16} />
      </a>
    </div>
    <ProgramCards lang={lang} featured />
  </div>
</section>

<section class="section lives" aria-labelledby="lives-title">
  <div class="container section-head">
    <div>
      <p class="eyebrow">{t.livesEyebrow}</p>
      <h2 id="lives-title">{t.livesTitle}</h2>
      <p class="section-sub">{t.livesText}</p>
    </div>
    <a class="text-link" href={url(lang, 'gallery')}>
      {t.viewPhotos}
      <Icon name="arrow" size={16} />
    </a>
  </div>
  <LivesStrip lang={lang} />
</section>

<section class="section section-paper" aria-labelledby="videos-title">
  <div class="container">
    <div class="section-head">
      <div>
        <p class="eyebrow">{t.videosEyebrow}</p>
        <h2 id="videos-title">{t.videosTitle}</h2>
      </div>
      <a class="text-link" href={url(lang, 'videos')}>
        {t.viewVideos}
        <Icon name="arrow" size={16} />
      </a>
    </div>
    <VideoCards lang={lang} limit={4} />
  </div>
</section>

<section class="section" id="donate">
  <div class="container">
    <DonatePanel lang={lang} />
  </div>
</section>
